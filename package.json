{
  "name": "playwright-typescript-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Robot Framework web tests ported to Playwright and TypeScript, against the same local site.",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "typescript": "5.9.3"
  }
}
